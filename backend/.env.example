# SnapClass Backend — Environment Variables
# Copy this file to .env and fill in values.

# Required: Supabase connection
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required: Secrets (min 32 chars, no defaults in production)
SESSION_SECRET=change-me-to-a-random-32-char-string
LOCKOUT_SECRET=change-me-to-a-random-32-char-string

# Dev mode: set to true for local development (relaxes secret requirements)
DEV_MODE=true

# Cookie security: set to false for local HTTP (localhost), true for HTTPS
COOKIE_SECURE=false

# CORS: allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Frontend (set in frontend/.env.local or docker-compose)
# BACKEND_URL=http://localhost:8000
